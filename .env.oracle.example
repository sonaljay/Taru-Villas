# Server-only configuration. Production imports require production mode.
ORACLE_OHIP_ENVIRONMENT=production
ORACLE_OHIP_GATEWAY=https://mtcs1pr.hospitality-api.ap-singapore-1.ocs.oraclecloud.com
ORACLE_OHIP_ENTERPRISE_ID=TVPL
ORACLE_OHIP_CLIENT_ID=replace-with-client-id
ORACLE_OHIP_CLIENT_SECRET=replace-with-client-secret
ORACLE_OHIP_APP_KEY=replace-with-application-key
ORACLE_OHIP_SCOPE=urn:opc:hgbu:ws:__myscopes__
# UAT gateway (with UAT credentials) for isolated connection diagnostics only:
# https://mtcs1ua.hospitality-api.ap-singapore-1.ocs.oc-test.com

# One private guest link for manual sharing and automatic service email.
# Dedicated 32-byte key encoded as base64; keep stable across deployments.
GUEST_PORTAL_LINK_KEY=
GUEST_PORTAL_ORIGIN=https://your-guest-portal.example
# Initial rollout: automatic email is disabled. Preview must never send.
GUEST_EMAIL_ENABLED=false
GUEST_EMAIL_FROM=Taru Villas <stay@your-verified-domain.example>
RESEND_API_KEY=
# Task-email sender settings remain separate.
